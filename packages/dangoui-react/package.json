{
  "name": "dangoui-react",
  "version": "0.3.0",
  "description": "Dangoui components for React Web and H5",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EchoTechFE/dangoui.git",
    "directory": "packages/dangoui-react"
  },
  "homepage": "https://github.com/EchoTechFE/dangoui/tree/main/packages/dangoui-react#readme",
  "bugs": "https://github.com/EchoTechFE/dangoui/issues",
  "type": "module",
  "license": "ISC",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "dist",
    "README.md",
    "MIGRATION.md",
    "COMPONENTS.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./icons": {
      "types": "./dist/icons/index.d.ts",
      "import": "./dist/icons/index.js"
    },
    "./icons/*": {
      "types": "./dist/icons/*.d.ts",
      "import": "./dist/icons/*.js"
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "generate": "node scripts/gen-icons.mjs",
    "check": "pnpm generate && tsc --noEmit",
    "build": "pnpm generate && vite build && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:package": "node scripts/verify-package.mjs",
    "dev": "pnpm build && vite --config example/vite.config.ts",
    "build:example": "tsc -p example/tsconfig.json && vite build --config example/vite.config.ts"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.1.15"
  },
  "devDependencies": {
    "@svgr/core": "^8.1.0",
    "@svgr/plugin-jsx": "^8.1.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@unocss/vite": "^0.57.7",
    "dangoui-design-token": "workspace:^",
    "happy-dom": "^13.3.8",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "sass": "1.69.5",
    "typescript": "^5.3.2",
    "unocss-preset-echo": "workspace:^",
    "vite": "^5.0.2"
  }
}
